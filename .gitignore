# ============================================================
# .gitignore cho Drugs Maker Flutter
# Flutter (Windows/Linux desktop) + Python + Build artifacts
# ============================================================

# ── Flutter / Dart ───────────────────────────────────────────
# Flutter build outputs
/build/

# Dart tool cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/

# Pub cache / package lock (keep pubspec.lock for reproducible builds)
# pubspec.lock  ← giữ lại để build reproducible

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Coverage
coverage/

# ── IDE / Editors ─────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
.eggs/

# ── Test / Debug artifacts ────────────────────────────────────
test_output.xlsx
test_out.xlsx
*.xlsx
*.log

# ── Linux packaging temp ──────────────────────────────────────
debian-pack/

# ── Linux .deb release files (generated) ─────────────────────
*.deb

# ── Windows NSIS build ────────────────────────────────────────
# Generated installer (keep .nsi script, exclude built .exe)
*-setup.exe

# Auto-generated version header (written by CI)
version.nsh

# ── Git ───────────────────────────────────────────────────────
*.orig
*.rej

# ── Secrets / Environment ─────────────────────────────────────
.env
.env.*
*.pem
*.key
*.jks
*.keystore
**/android/key.properties
**/android/app/key.properties
**/android/local.properties

